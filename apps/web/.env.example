# Public value: the build puts NEXT_PUBLIC_* into the browser bundle. Never put a secret here (ADR-0016).
NEXT_PUBLIC_API_URL=http://localhost:8080
# The Firebase web config. These values are public (ADR-0016).
NEXT_PUBLIC_FIREBASE_API_KEY=dummy-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dummy-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dummy-project
NEXT_PUBLIC_FIREBASE_APP_ID=dummy-app-id
