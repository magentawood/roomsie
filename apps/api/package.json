{
  "name": "@roomsie/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "content",
    "dist",
    "drizzle",
    "drizzle-analytics"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:analytics": "drizzle-kit generate --config drizzle-analytics.config.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.1",
    "@roomsie/contract": "workspace:*",
    "@sentry/core": "11.9.0",
    "@sentry/node": "11.9.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.13",
    "markdown-it": "^15.0.3",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@roomsie/config": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
