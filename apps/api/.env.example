# Copy to .env for local development. Real values live only in the deploy environment (ADR-0016).
PORT=8080
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roomsie
# T-24: the analytics database (ADR-0012). Empty: the API writes no events.
ANALYTICS_DATABASE_URL=
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
# T-44: the public key that the web joins Realtime with.
SUPABASE_ANON_KEY=dummy-anon-key
R2_ACCOUNT_ID=dummy-account-id
R2_ACCESS_KEY_ID=dummy-access-key-id
R2_SECRET_ACCESS_KEY=dummy-secret-access-key
R2_BUCKET_PHOTOS=roomsie-photos
R2_BUCKET_PRIVATE=roomsie-private
R2_PUBLIC_URL=https://photos.example.com
# T-11: the model keys of PD7. Empty: the API calls no model.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MODEL_PRIMARY=deepseek-flash
MODEL_FALLBACK=gemini-3.5-flash-lite
MODEL_TIMEOUT_MS=10000
# T-07: the DSN of the API project of Sentry. Empty: Sentry stays off.
SENTRY_DSN_API=
FIREBASE_PROJECT_ID=dummy-firebase-project
# T-44: the service account JSON, on one line, for the claims of Realtime, the push alerts and the account deletion (T-53).
# Empty: the realtime route gives 503, and account deletion keeps the Firebase user.
FIREBASE_SERVICE_ACCOUNT=
# T-55: the IAM user of Amazon SES. From T-46 it also has the ID bucket and Rekognition (ADR-0020). Empty: the API sends no email alert and takes no ID check.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# T-19: the Firebase uids of the moderators, comma-separated, and the rules of PD18. Each has a default.
MODERATOR_UIDS=
# T-46: the Firebase uids of the ID reviewers, comma-separated, and the private bucket of the ID checks. Empty: nobody reviews, and the API takes no ID check.
REVIEWER_UIDS=
ID_BUCKET=
REPORT_HIDE_AT_REPORTERS=2
REPORT_SAFETY_REASONS=harassment,under_18
# T-62: the admin home marks a report late after these hours (PD18), and an ID check (PD8).
REPORT_SAFETY_LATE_HOURS=4
REPORT_LATE_HOURS=24
ID_CHECK_LATE_HOURS=24
# A Form B note counts in the order of the results above this confidence (PD3a, T-14).
FORM_B_CONFIDENCE_FLOOR=0.5
# T-12: below this token probability, an extracted value is unclear (PD7). The order of the questions of the assistant (PC-39).
ASSISTANT_MIN_PROBABILITY=0.8
ASSISTANT_QUESTION_ORDER=intent,areas,budget,moveDate,lifestyle
# T-34: below this token probability, the band of the router is not sure, and the turn is core. T-61 keeps 0.8.
ROUTER_MIN_PROBABILITY=0.8
# T-13: the time in milliseconds for all the attempts of the composer. After it, the scripted reply goes out. T-61 sets 3500.
COMPOSER_DEADLINE_MS=3500
# T-36: the confidence of a Form B note with no token probabilities: a note of Gemini, or of DeepSeek whose tokens do not hold the topic. The notes of a sensitive turn: none, hidden or visible (PC-17).
OBSERVER_UNSCORED_CONFIDENCE=0.5
OBSERVER_SENSITIVE_NOTES=none

# The limits of PD9 (T-21). The first values are guesses that the team revises with the data (PC-10).
VISITOR_TURN_CAP=5
VISITOR_TURN_BACKSTOP=15
VISITOR_SESSIONS_PER_DEVICE=10
VISITOR_SESSIONS_PER_IP=100
VISITOR_SESSIONS_PER_IP_RANGE=500
TYPED_TURNS_PER_MINUTE=10
# The daily model spend in rupees: the alerts go at 70% and 100%, and the chat never stops.
DAILY_SPEND_RUPEES=500
# The team group in Telegram: the spend alerts and the flips of the Gemini switch (T-65). Empty: each is only a log line.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

