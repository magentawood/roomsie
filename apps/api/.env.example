# Copy to .env for local development. Real values live only in the deploy environment (ADR-0016).
PORT=8080
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roomsie
# T-24: the analytics database (ADR-0012). Empty: the API writes no events.
ANALYTICS_DATABASE_URL=
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key
# T-44: the public key that the web joins Realtime with.
SUPABASE_ANON_KEY=dummy-anon-key
R2_ACCOUNT_ID=dummy-account-id
R2_ACCESS_KEY_ID=dummy-access-key-id
R2_SECRET_ACCESS_KEY=dummy-secret-access-key
R2_BUCKET_PHOTOS=roomsie-photos
R2_BUCKET_PRIVATE=roomsie-private
R2_PUBLIC_URL=https://photos.example.com
DEEPSEEK_API_KEY=dummy-deepseek-key
GEMINI_API_KEY=dummy-gemini-key
SENTRY_DSN_API=https://dummy@example.ingest.sentry.io/0
FIREBASE_PROJECT_ID=dummy-firebase-project
# T-44: the service account JSON, on one line, for the claims of Realtime, the push alerts and the account deletion (T-53).
# Empty: the realtime route gives 503, and account deletion keeps the Firebase user.
FIREBASE_SERVICE_ACCOUNT=
# T-55: the IAM user of Amazon SES. From T-46 it also has the ID bucket and Rekognition (ADR-0020). Empty: the API sends no email alert and takes no ID check.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# T-19: the Firebase uids of the moderators, comma-separated, and the rules of PD18. Each has a default.
MODERATOR_UIDS=
# T-46: the Firebase uids of the ID reviewers, comma-separated, and the private bucket of the ID checks. Empty: nobody reviews, and the API takes no ID check.
REVIEWER_UIDS=
ID_BUCKET=
REPORT_HIDE_AT_REPORTERS=2
REPORT_SAFETY_REASONS=harassment,under_18
