{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git config core.hooksPath .githooks"
          },
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/tools/sync-main.sh\" ] || sh \"$CLAUDE_PROJECT_DIR/tools/sync-main.sh\" SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/tools/sync-main.sh\" ] || sh \"$CLAUDE_PROJECT_DIR/tools/sync-main.sh\" UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agentic-devkit": {
      "source": {
        "source": "github",
        "repo": "magentawood/agentic-devkit"
      }
    }
  },
  "enabledPlugins": {
    "agentic-devkit@agentic-devkit": true
  }
}
